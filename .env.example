DISCORD_TOKEN=your_discord_bot_token
IRC_BRIDGE_ENABLED=true
IRC_BRIDGE_HOST=0.0.0.0
IRC_BRIDGE_PORT=8765
IRC_BRIDGE_AUTH_TOKEN=change-me
IRC_BRIDGE_CHANNEL_ID=123456789012345678
IRC_BRIDGE_MAX_BUFFERED_MESSAGES=250
HYPIXEL_API_KEY=your_hypixel_api_key
# Optional Bearer token for the Crafty.gg name-history fallback.
CRAFTY_API_KEY=
# Optional legacy defaults for the first server setup.
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_ROLE_ID=123456789012345678
# Optional comma-separated Discord user IDs with admin bot access.
ADMIN_USER_IDS=885542911511515146
CHECK_INTERVAL_MINUTES=5
MOD_UPDATE_CHECK_MINUTES=60
STATUS_UPDATE_MINUTES=30
MOCK_MODE=false
VOTE_BAR_FILLED_EMOJI=<:lime_stained_glass_pane:1484178221099520000>
VOTE_BAR_EMPTY_EMOJI=<:gray_stained_glass_pane:1484178273549156372>
# Text-to-speech: docker-compose.yml sets TTS_URL to the tts service; without it /tts is disabled.
# TTS_URL=http://localhost:5000
# Name of the role that may use /tts; the bot creates it when it is missing (needs Manage Roles).
TTS_ROLE_NAME=TTS
TTS_MAX_QUEUE=10
TTS_MAX_CHARS=300
# Text channel for /music and its control panel; the bot creates it when missing (needs Manage Channels).
MUSIC_CHANNEL_NAME=voice
# yt-dlp binary for /music play; the Docker image installs it.
# YTDLP_PATH=yt-dlp
